# Application
PROJECT_DEFENSE_APP_NAME=Project Defense AI
PROJECT_DEFENSE_APP_VERSION=0.2.0
PROJECT_DEFENSE_ENVIRONMENT=development
PROJECT_DEFENSE_DEBUG=false

# Database
PROJECT_DEFENSE_DATABASE_URL=postgresql+asyncpg://project_defense:project_defense@localhost:5432/project_defense
PROJECT_DEFENSE_TEST_DATABASE_URL=postgresql+asyncpg://project_defense:project_defense@localhost:5433/project_defense_test
PROJECT_DEFENSE_DB_POOL_SIZE=10
PROJECT_DEFENSE_DB_MAX_OVERFLOW=20
PROJECT_DEFENSE_DB_POOL_TIMEOUT=30

# Redis / Workers
PROJECT_DEFENSE_REDIS_URL=redis://localhost:6379/0
PROJECT_DEFENSE_WORKER_CONCURRENCY=4

# Security — MUST be overridden in production
PROJECT_DEFENSE_SECRET_KEY=change-me-before-production-use

# JWT
PROJECT_DEFENSE_JWT_ALGORITHM=HS256
PROJECT_DEFENSE_JWT_ACCESS_EXPIRE_MINUTES=15
PROJECT_DEFENSE_JWT_REFRESH_EXPIRE_DAYS=7

# Development — set to true ONLY in development/testing, never in production
PROJECT_DEFENSE_DEV_AUTH_BYPASS=true

# GitHub Integration (optional — leave empty to disable)
PROJECT_DEFENSE_GITHUB_TOKEN=
PROJECT_DEFENSE_GITHUB_WEBHOOK_SECRET=

# GitHub OAuth App credentials (required for real OAuth flow)
PROJECT_DEFENSE_GITHUB_CLIENT_ID=
PROJECT_DEFENSE_GITHUB_CLIENT_SECRET=

# GitHub mock mode — safe local dev substitute for real OAuth
# NEVER set to true in production (enforced at startup)
PROJECT_DEFENSE_GITHUB_MOCK_MODE=false

# Anthropic / AI Agents (optional — leave empty for deterministic mock mode)
PROJECT_DEFENSE_ANTHROPIC_API_KEY=
PROJECT_DEFENSE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# AI Evaluation (Milestone 5)
# true → evaluate inline/synchronously (dev/demo); false → background worker (prod)
PROJECT_DEFENSE_AI_EVALUATION_SYNC_MODE=true
# Confidence threshold — evaluations below this are escalated to a human mentor
PROJECT_DEFENSE_AI_CONFIDENCE_THRESHOLD=0.70

# API
PROJECT_DEFENSE_API_V1_PREFIX=/api/v1
# Comma-separated origins for CORS (leave empty in development)
PROJECT_DEFENSE_CORS_ORIGINS=

# Logging
PROJECT_DEFENSE_LOG_LEVEL=INFO

# Demo Mode (Milestone 6)
# true → auto-seeds 5 demo students + 1 mentor at startup
PROJECT_DEFENSE_DEMO_MODE=false
# URL of the frontend — added to CORS allowed origins
PROJECT_DEFENSE_FRONTEND_URL=http://localhost:3000
